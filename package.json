{
  "name": "paintcanvas",
  "version": "0.1.0",
  "description": "Open-source painting engine and renderer for the browser, with optional UI.",
  "keywords": [
    "drawing",
    "painting",
    "canvas",
    "brush",
    "pen",
    "stylus",
    "web-components",
    "lit"
  ],
  "author": "Matt Scheurich <matt@lvl99.com>",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./ui": "./src/ui/index.ts",
    "./ui/*": "./src/ui/*/index.ts",
    "./lib/*": "./src/lib/*/index.ts",
    "./testing/*": "./src/testing/*.ts",
    "./locales/*": "./locales/*"
  },
  "files": [
    "dist",
    "locales",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p . && vite build",
    "typecheck": "tsc -p .",
    "test": "vitest --run --project paintcanvas",
    "test:browser": "vitest --run --project paintcanvas-browser",
    "test:all": "vitest --run",
    "coverage": "vitest --run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:validators": "node scripts/build-validators.ts",
    "demo": "vite demo --port 5190 --strictPort"
  },
  "packageManager": "pnpm@12.10.1",
  "peerDependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "ajv": "^8.20.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lit": "^2.3.1",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "lit": "^3.3.3",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
