{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "./dist/types",
    // Lets scripts run directly with Node.js type stripping, which needs explicit .ts extensions
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": ["vite/client", "node"]
  },
  "include": [
    "src",
    "src/**/*.json",
    "scripts",
    "locales/*.json",
    "package.json"
  ],
  // Generated validators are typed by their `.d.ts`
  "exclude": ["src/**/*.generated.js"]
}
